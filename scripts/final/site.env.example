# Site file for scripts/final/*.sh: copy it outside the repository (it holds machine paths), edit it, and pass
# --site <file> to every script. Plain KEY=value lines (sourced by bash); ${VAR} references work.
# Unset variables default to the training server's layout (the ROOT_* values below), where every record
# path is real. Never put tokens or keys here.

# Everything the scripts write: worktrees of the training commits, runs, evaluations, packed CSVs, plans and logs.
V2D_WORK=/data/v2d_final

# Interpreters (setup_env.sh builds them; environment/README.md).
FC_PYTHON=${V2D_WORK}/envs/flashchord/bin/python       # training, export, evaluation
KIT_PYTHON=${V2D_WORK}/envs/v2dkit/bin/python          # kit packer and uploader validation
RETARGET_PYTHON=${V2D_WORK}/envs/v2d/bin/python        # Isaac Sim 5.1 / Isaac Lab 2.3.2 env: retargeting, input builders
ZX_KIT_PYTHON=${V2D_WORK}/envs/zx_g2_builder/bin/python # a teammate's Tier-2 G2 input builder (environment/zx_g2_builder.pip-freeze.txt)

# The stock FlashCHORD runtime (nvidia-isaac/video_to_data @ 8c778f9, robotic_grounding/flash_chord, with LFS assets),
# the Oct-11 submission kit (KIT_MANIFEST.json 398947a7...) and the challenge dataset root (contains track_2/).
V2D_RUNTIME=${V2D_WORK}/video_to_data_8c778f9/robotic_grounding/flash_chord
V2D_KIT=/path/to/v2d_submission_kit
V2D_DATA=${V2D_WORK}/data/video_to_data_challenge

# Where the set records' placeholders live on this machine. The records (and the absolute task.parquet paths stored
# inside every checkpoint and export) name the training server's roots; restore the payload at the same layout, or
# bind-mount / symlink it there (the stock evaluator loads the stored parquet path as it is).
ROOT_ME=/root/autodl-tmp/haoran.zhang        # <ME>   our work root: data/, fc_runs/, tmp_analysis/, transfer/
ROOT_ZX=/root/autodl-tmp/zuxing.lu           # <ZX>   a teammate's work root on the training server (G2 data, the teammate's runs)
ROOT_HAN=/root/autodl-tmp/han.zhou           # <HAN>  the Tier-3 reconstruction pipeline's releases
# ROOT_ZX5090=                               # <ZX5090> copy of a teammate's RTX 5090 machine root (Tier-2 ep19/ep25 resumes)
# ROOT_ZXWS=                                 # <ZXWS>   copy of a teammate's workstation root
T1_MOTION=${ROOT_ME}/data/human_motion_data  # Tier 1 <MOTION>: the derived Tier-1 motion data (TR/repro)
T1_RUNS=${ROOT_ME}/fc_runs                   # Tier 1 <RUNS> as recorded: fork pairs, T1improve exports, trial results
T1_ZX_RUNS=${ROOT_ZX}/runs/2026-10-14-patience-runin   # Tier 1 <RUNS>/runin*/epNN: a teammate's runin chains (ep01, ep04,
                                             # ep19 resume sources; ep04's counted checkpoint runin_cont4/ep04/model_358000)
T1_EXPORTS=${ROOT_ME}/transfer/t1best_20261026/payload/exports   # the t1best payload's exports/ (23 evaluated files)

# GPUs: the first entry is the default --gpu. REQUIRE_IDLE_GPU=1 makes every launch refuse a GPU on which nvidia-smi
# lists any compute process (shared machines).
GPUS=0
REQUIRE_IDLE_GPU=0

# Optional: a checkout whose FlashCHORD LFS assets are real files; worktrees are then filled from it (sha256-checked)
# instead of `git lfs pull`.
# LFS_FROM=/path/to/a/filled/checkout

# W&B: off. The Tier-1 C3r2_wide lines take WANDB_MODE (default disabled) and optional WANDB_ENTITY / WANDB_PROJECT.
# WANDB_MODE=disabled
