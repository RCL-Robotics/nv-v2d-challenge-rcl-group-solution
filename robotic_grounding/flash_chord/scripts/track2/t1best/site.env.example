# Site settings of the t1best tools (fork_train.py, eval_watch.py, trials_eval.py, check_items.py). Copy to
# site.env, edit, then either pass --site site.env to a tool or `set -a; source site.env; set +a`. A variable set in
# the environment wins over this file. ${VAR} references work. Do not put tokens or keys here.

# Everything the tools write: forks/<name>/, trials/<name>/, evallock/.
T1_WORK=/data/t1best/work

# The copied transfer payload (README_NEW_MACHINE.md): runs root (<RUNS> in configs/items/*.json; pinned pairs,
# fork origins and run records) and the evaluated exports (<item>/model_<N>.safetensors).
T1_RUNS=/data/t1best/payload/runs
T1_EXPORTS=/data/t1best/payload/exports

# Derived motion data (<MOTION>, HUMAN_MOTION_DATA_DIR): the transferred human_motion_data tree.
V2D_MOTION=/data/t1best/payload/data/human_motion_data
# Challenge dataset root that CONTAINS track_2/ (the packer and the scorer read it).
V2D_DATA=/data/t1best/payload/data/video_to_data_challenge
# Stock FlashCHORD runtime at 8c778f9 (robotic_grounding/flash_chord of nvidia-isaac/video_to_data), with the
# transferred stock hull cache in src/flash_chord/assets/.cache/convex.
V2D_RUNTIME=/data/t1best/video_to_data_8c778f9/robotic_grounding/flash_chord
# Extracted submission kit (the folder with KIT_MANIFEST.json, examples/, tools/, metric_code/, v2dlb/).
V2D_KIT=/data/t1best/payload/v2d_submission_kit_src/v2d_submission_kit

# Interpreters: the flashchord env (training, export, evaluation; also runs these tools) and the kit's venv (packer,
# scorer). See ../repro/README.md "Environments".
FC_PYTHON=/data/t1best/envs/flashchord/bin/python
KIT_PYTHON=/data/t1best/envs/v2dkit/bin/python

# Training tree (robotic_grounding/flash_chord). Default: the checkout these tools live in.
# T1_CODE=/data/t1best/v2d/robotic_grounding/flash_chord

# GPUs the evaluators may use (default: every GPU nvidia-smi lists), GPUs never to use, and whether to refuse a GPU
# that runs an NVIDIA MPS server (1 on the original machine, where training ran under MPS). Set REFUSE_MPS=1 wherever
# training runs under MPS: an evaluation past its timeout is stopped as a process group, and a signal to one MPS
# client can take down every job of that GPU.
# GPUS=0,1,2,3
EXCLUDE_GPUS=
REFUSE_MPS=0
# Free GPU memory an evaluation needs before it starts (MiB; an evaluation peaks at about 1.5 GiB).
EVAL_MIN_FREE_MB=5632
# Optional CPU pinning of evaluations per GPU, "<gpus>=<cpu list>;...", e.g. one NUMA node's cores per GPU group
# (keep the quotes: `source site.env` would split the line at the ';'):
# EVAL_CPUS="0,1,2=48-51,152-155;3,4,5,6,7=100-103,204-207"
# Optional extra lock folders (colon list) whose gpu<g>.lock other drivers hold during their evaluations; a lane is
# taken only when all of them are free (they are opened read-only, never created).
# EVAL_LOCKDIRS=/path/to/other/driver/evallock
# Optional: FLASH_CHORD_CACHE_DIR for the evaluator (default unset = the stock runtime's own cache).
# EVAL_CACHE_DIR=

# Weights & Biases stays off (disabled). To log, set online plus your entity/project and export WANDB_API_KEY in the
# shell, never here.
WANDB_MODE=disabled
