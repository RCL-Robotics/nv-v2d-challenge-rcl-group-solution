# Line spec: Track 2 Tier 1, method C3r2 (arm C3r2_wide). Data, not code: plain KEY=value lines (no expansion),
# sourced by reproduce.sh and read by tests/check_train_commands.py. Every value is what the submitted run used.

LINE_NAME=c3r2_tier1
ARM=C3r2_wide
TRACK=track_2_tier1

# Input data: HF dataset nvidia/video_to_data_challenge at this revision, Tier-1 folder of Track 2.
DATA_REPO=nvidia/video_to_data_challenge
DATA_REVISION=5f68335f3acc802033d1e80728c1633197521de8
TIER_DIR=tier_1_multiview_caption
# soma_to_g1.py --fps (retarget_all.sh --fps)
RETARGET_FPS=30

# Training: one run per episode, `python scripts/train_rl.py` with exactly these Hydra overrides (train_all.sh).
EXPERIMENT=g1_recon_body_coord_rsi_r2
RESET_SEED=42
MAX_ITERATIONS=45000
# scene.support=false when the episode's <seq>_support.usda contains no `def Cylinder` / `def Cube` (floor only).
# Computed from the data; for Tier 1 it selects these 16 episodes (checked by tests/check_support_rule.py):
EXPECTED_FLOOR_ONLY="00 04 05 08 10 12 14 15 18 19 21 22 23 24 26 29"

# Checkpoint selection: the FINAL checkpoint named by <run>/final.json (written by the training runner at the
# help-zero-tail early stop, or at max_iterations). Pre-registered; no best-of selection.
SELECTION=final_json

# Export to the stock ActorCritic format: equivalence tolerance 1e-4 for Tier 1 (the exporter default 1e-5 refuses
# most long runs; the measured max_rel_diff of the 30 submitted exports was 8.1e-6 .. 6.47e-5).
EXPORT_TOLERANCE=1e-4

# Evaluation: the kit's evaluator on the stock runtime, one world, one episode per call. check_eval_inputs.py
# (run by final_eval.sh, repeat_eval.sh and pack.sh) checks the runtime HEAD, both evaluate_policy.py copies and
# the kit's KIT_MANIFEST.json against these values.
EVAL_WORLD_COUNT=1
STOCK_RUNTIME_REPO=https://github.com/nvidia-isaac/video_to_data.git
STOCK_RUNTIME_COMMIT=8c778f905cb35f76f8e6cd6e2ea486da4fb9e0ef
EVAL_SCRIPT_SHA256=160d24f5fbeb70ccd569ca4192056f1892b2a9f2999066db9d8279461648fdf1

# Provenance. The checkpoints were trained from a local commit (recorded by W&B as git.commit) whose files under
# robotic_grounding/flash_chord are identical to CODE_COMMIT, the commit the packed CSV cites.
TRAINED_COMMIT=61fa5d31ff8054bf1e5cf5375ef0957e54d2729b
CODE_COMMIT=f2923d61817e61eb37d939e0f75e5b4a7aaa5cbf
