# Line spec: Track 2 Tier 1, mixed selection (C3r2 on 11 episodes, the RSI rolling start on 19). Data, not code:
# plain KEY=value lines (no expansion), sourced by bash and read by the Python checks. A RECORD of the current best
# per-episode selection (frozen 2026-10-21 23:13 UTC+8); it is still being improved and has not been submitted.
#
# Per episode: mix_tier1_episodes.tsv (method, run, iteration, raw and exported checkpoint sha256, the 5-run
# evaluation). Per training stage: mix_tier1_train_stages.tsv (the exact Hydra overrides, with <MOTION> = the derived
# motion-data root and <RUNS> = a runs root; resumes name the stage checkpoint they start from). Every stage runs
#   cd robotic_grounding/flash_chord && PYTHONPATH=$PWD/src python scripts/train_rl.py <overrides>
# on one GPU, with the flashchord env first on PATH (source env/fc_env.sh), as for lines/c3r2_tier1.env.
# The C3r2 stages are the C3r2 line's command (train_all.sh --line lines/c3r2_tier1.env; [..] = optional W&B
# keys); their override lists compose to the same config from this tree as from the tree that trained them.
# The rolling-start stages use experiment g1_recon_body_coord_rsi_r2_runin (= C3r2 with reset.run_in_steps 20 and
# reset.min_horizon 30), with scene.support written out for every episode, W&B off and a local metrics.jsonl.
#
# Code. This commit merges RUNIN_CODE_COMMIT (C3r2 plus the PSI, termination-patience and rolling-start arms, all off
# by default) with the C3r2 reproduction tooling (TOOLING_COMMIT, on top of C3R2_CODE_COMMIT). Its training, export
# and evaluation code (the protected paths of tests/check_code_unchanged.sh) equals RUNIN_CODE_COMMIT, so
#   bash tests/check_code_unchanged.sh <RUNIN_CODE_COMMIT>
# passes here; run without an argument it compares with the C3r2 line's CODE_COMMIT and lists the rolling-start
# additions. For the C3r2 experiment those additions are inert: reset.run_in_steps and
# termination.violation_patience default to 0, which keeps the stock reference clock and the stock termination.
# Short commit ids below. RUNIN_CODE_COMMIT and TOOLING_COMMIT are this commit's two parents. RUNIN_CHAIN_COMMIT is
# not on a branch of this repository; what identifies its code is its tree, RUNIN_CODE_TREE.

LINE_NAME=mix_tier1
ARM=mix_tier1
TRACK=track_2_tier1

# Input data, as lines/c3r2_tier1.env.
DATA_REPO=nvidia/video_to_data_challenge
DATA_REVISION=5f68335f3acc802033d1e80728c1633197521de8
TIER_DIR=tier_1_multiview_caption
RETARGET_FPS=30
EXPECTED_FLOOR_ONLY="00 04 05 08 10 12 14 15 18 19 21 22 23 24 26 29"

# Tables (next to this file).
EPISODES_TABLE=mix_tier1_episodes.tsv
STAGES_TABLE=mix_tier1_train_stages.tsv

# Methods. run_set in the tables:
#   c3r2_wide    the C3r2 line's runs (lines/c3r2_tier1.env): 11 episodes;
#   runin_queue  rolling start, one run per episode, cap 120,000 (ep03: 150,000, set when its queue started), the
#                help-zero early stop off, stopped by hand on a plateau (no gain >= 0.005 AUC over 10k iterations)
#                or still running at selection; ep20 was resumed once from its model_24000: 16 episodes;
#   runin_chain  rolling start for episodes 01, 04, 19: a 45,000-iteration run (early stop on), then continuations
#                with the early stop off that resume from the previous stage's final.json checkpoint, to 90,000
#                (and for 01 / 04 to 135,000 / 180,000): 3 episodes.
C3R2_LINE=c3r2_tier1.env
C3R2_EXPERIMENT=g1_recon_body_coord_rsi_r2
RUNIN_EXPERIMENT=g1_recon_body_coord_rsi_r2_runin
RESET_SEED=42
RUNIN_MAX_ITERATIONS=120000
RUNIN_EARLY_STOP_HELP_ZERO_TAIL=0

# Checkpoint selection (NOT pre-registered): per episode, the checkpoint with the single best existing Tier-1
# evaluation (highest AUC, ties -> lower MPPE -> earlier) over the C3r2 final.json and periodic checkpoints and the
# rolling-start checkpoints. That checkpoint is exported once, the same file is evaluated 5 times, and the run whose
# AUC is closest to the 5-run mean (ties -> lower run) is the one to pack (column eval_run). Those 30 runs give
# AUC 0.8935, SP-SR 0.967, MP-SR 0.933, MPPE 2.78 cm; the means of the 5 runs give AUC 0.8930.
SELECTION=best_existing_eval_then_closest_to_mean_of_5
EVAL_REPEATS=5

# Export and evaluation, as lines/c3r2_tier1.env. Each checkpoint was exported by its own training tree's exporter;
# this tree's exporter only adds the removal of termination.violation_patience, which none of these configs sets.
# max_rel_diff per episode is in the episodes table.
EXPORT_TOLERANCE=1e-4
EVAL_WORLD_COUNT=1
STOCK_RUNTIME_REPO=https://github.com/nvidia-isaac/video_to_data.git
STOCK_RUNTIME_COMMIT=8c778f905cb35f76f8e6cd6e2ea486da4fb9e0ef
EVAL_SCRIPT_SHA256=160d24f5fbeb70ccd569ca4192056f1892b2a9f2999066db9d8279461648fdf1

# Provenance (column `code` of the episodes table names one of these).
#   C3R2_TRAINED_COMMIT  local commit that trained, exported and evaluated the C3r2 runs; its flash_chord files equal
#                        C3R2_CODE_COMMIT's
#   RUNIN_CODE_COMMIT    the rolling-start code; the runin_queue runs trained from a checkout of it
#   RUNIN_CHAIN_COMMIT   the commit the runin_chain runs trained from; same tree as RUNIN_CODE_COMMIT (RUNIN_CODE_TREE)
#   TOOLING_COMMIT       the C3r2 reproduction tooling (C3R2_CODE_COMMIT + scripts only)
C3R2_TRAINED_COMMIT=61fa5d31ff8054bf1e5cf5375ef0957e54d2729b
C3R2_CODE_COMMIT=f2923d61817e61eb37d939e0f75e5b4a7aaa5cbf
RUNIN_CODE_COMMIT=b39b69be6c2f
RUNIN_CODE_TREE=c68c454349fe
RUNIN_CHAIN_COMMIT=0868a3f4a29a
TOOLING_COMMIT=41403d3f94f9
