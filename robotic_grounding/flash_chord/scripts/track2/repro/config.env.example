# Copy to config.env (or any path passed with --config) and edit. reproduce.sh sources it with bash, so ${VAR}
# references work. Every variable can also be set in the environment instead. Do not put tokens or keys here.

# Root for everything the pipeline writes: runs, exports, evaluator results, packed CSVs and logs.
# Use absolute paths; relative ones are taken from the directory reproduce.sh is started in.
V2D_WORK=/data/v2d_c3r2

# Challenge dataset root: the directory that CONTAINS track_2/ (get_data.sh downloads into it; the packer reads it).
V2D_DATA=${V2D_WORK}/data/video_to_data_challenge

# Derived motion data (HUMAN_MOTION_DATA_DIR): SOMA inputs from track2_to_soma_inputs.py and the G1 retargets.
V2D_MOTION=${V2D_WORK}/data/human_motion_data

# Stock FlashCHORD runtime used by the official evaluator: nvidia-isaac/video_to_data at 8c778f9,
# robotic_grounding/flash_chord with its LFS assets (env/get_stock_runtime.sh fetches it).
V2D_RUNTIME=${V2D_WORK}/video_to_data_8c778f9/robotic_grounding/flash_chord

# Extracted official submission kit (the directory that holds KIT_MANIFEST.json, examples/, tools/).
V2D_KIT=/path/to/v2d_submission_kit

# Interpreters (see README "Environments").
FC_PYTHON=${V2D_WORK}/envs/flashchord/bin/python      # flashchord env: training, export, evaluation
RETARGET_PYTHON=python                                 # Isaac Sim 5.1 / Isaac Lab 2.3.2 env with robotic_grounding
# RETARGET_ACTIVATE=/path/to/activate_retarget_env.sh  # optional file sourced before data conversion / retargeting
KIT_PYTHON=${V2D_WORK}/envs/v2dkit/bin/python          # Python 3.11 venv with the kit's requirements.txt (packer)

# GPUs and jobs per GPU for training (one job = one episode). Evaluation always runs one job per GPU.
GPUS=0,1,2,3,4,5,6,7
JOBS_PER_GPU=1
# Retargeting episodes at a time per GPU (the original ran all 30 at once on 8 GPUs, about 4 per GPU).
RETARGET_JOBS_PER_GPU=4

# Optional: a directory whose convex/ holds FlashCHORD's convex-decomposition cache (README "Caveats"). Unset, each
# tree uses its own src/flash_chord/assets/.cache, as in the original run.
# FLASH_CHORD_CACHE_DIR=/path/to/hosted/cache

# Weights & Biases: off by default. To log, set WANDB_MODE=online plus WANDB_ENTITY / WANDB_PROJECT, and export
# WANDB_API_KEY in your shell (never in this file).
WANDB_MODE=disabled
# WANDB_ENTITY=
# WANDB_PROJECT=

# Commit URL written into the packed CSV (column code_commit_url). Default: the GitHub URL of this checkout's HEAD
# commit (origin must be a github.com remote and HEAD must be pushed).
# CODE_COMMIT_URL=https://github.com/<owner>/<repo>/commit/<sha>

# Packed CSV name.
# SUBMISSION_CSV=${V2D_WORK}/submissions/C3r2_tier1.csv
